    "@fastify/static": "^7.0.4",
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.1",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "minipass": "^7.1.3",
    "sharp": "^0.35.1",
    "stream-wormhole": "^1.1.0",
    "zod": "^3.23.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@control-actions/shared": "*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
