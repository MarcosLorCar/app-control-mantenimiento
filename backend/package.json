    "db:seed": "tsc --noEmit && tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/busboy": "^3.2.0",
    "@fastify/cookie": "^9.3.1",
    "@fastify/jwt": "^8.0.1",
