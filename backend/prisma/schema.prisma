generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH / USERS ====================

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  canWrite    Boolean @default(false)
  canManage   Boolean @default(false)

  users User[]

  @@map("roles")
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  passwordHash       String
  fullName           String
  roleId             Int
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  role    Role     @relation(fields: [roleId], references: [id])
  actions Action[]

  @@index([roleId])
  @@map("users")
}

// ==================== LOCATION HIERARCHY ====================

model InfrastructureType {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  icon        String?
  color       String?
  deletedAt   DateTime?

  locations     Location[]
  materialTypes MaterialType[] // <--- Relation to MaterialType

  @@map("infrastructure_types")
}

model Location {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  
  // Materialized Path for fast path resolution & descendant lookups
  // Format: "/rootId/childId/grandchildId/" (e.g., "/1/4/12/")
  path        String    @default("/")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  latitude    Float?
  longitude   Float?
  image       String?   // <--- Image path of the location

  infraTypeId Int
  infraType   InfrastructureType @relation(fields: [infraTypeId], references: [id])

  // Recursive self-relation
  parentId    Int?
  parent      Location?  @relation("LocationTree", fields: [parentId], references: [id])
  children    Location[] @relation("LocationTree")

  // Target links
  materials   Material[]
  actions     Action[]
  photos      LocationPhoto[]

  @@index([parentId])
  @@index([path])
  @@index([infraTypeId])
  @@map("locations")
}

// ==================== MATERIAL CATALOG ====================

model MaterialType {
  id               Int       @id @default(autoincrement())
  code             String    @unique
  name             String
  description      String?
  icon             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  categories       InfrastructureType[]
  customAttributes Json      @default("[]") // <--- Technical attributes per material type

  materials  Material[]

  @@map("material_types")
}

// Planned for future use — no routes or services connect to this table yet.
model FixedProperty {
  id    Int    @id @default(autoincrement())
  code  String @unique
  name  String
  type  String @default("STRING")

  @@map("fixed_properties")
}

// ==================== MATERIAL INSTANCES ====================

model Material {
  id           Int       @id @default(autoincrement())
  name         String
  description  String?
  installedAt  DateTime  @default(now())
  attributes   Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  typeId Int
  type   MaterialType @relation(fields: [typeId], references: [id])

  locationId Int?
  location   Location? @relation(fields: [locationId], references: [id])

  actions ActionMaterial[]

  @@index([typeId])
  @@index([locationId])
  @@map("materials")
}

// ==================== ACTIONS ====================

model Action {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  performedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  materials ActionMaterial[]

  locationId Int?
  location   Location? @relation(fields: [locationId], references: [id])

  latitude  Float?
  longitude Float?

  performedBy Int
  performer   User    @relation(fields: [performedBy], references: [id])
  photos      LocationPhoto[]

  @@index([locationId])
  @@index([performedBy])
  @@index([performedAt])
  @@map("actions")
}

enum MaterialOperation {
  INSTALL
  UNINSTALL
  UPDATE
}

model ActionMaterial {
  actionId    Int
  materialId  Int
  operation   MaterialOperation
  snapshot    Json? // { name: string, description: string | null, attributes: Record<string, unknown> }

  action      Action   @relation(fields: [actionId], references: [id], onDelete: Cascade)
  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([actionId, materialId])
  @@map("action_materials")
}

model SystemSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String

  @@map("system_settings")
}

model LocationPhoto {
  id          Int       @id @default(autoincrement())
  url         String
  description String?
  takenAt     DateTime  @default(now())
  createdAt   DateTime  @default(now())

  locationId  Int
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  actionId    Int?
  action      Action?   @relation(fields: [actionId], references: [id], onDelete: SetNull)

  @@index([locationId])
  @@index([actionId])
  @@map("location_photos")
}

