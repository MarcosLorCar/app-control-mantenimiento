generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH / USERS ====================

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  canWrite    Boolean @default(false)
  canManage   Boolean @default(false)

  users User[]

  @@map("roles")
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String
  passwordHash       String
  fullName           String
  roleId             Int
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  role    Role     @relation(fields: [roleId], references: [id])
  actions Action[]

  @@index([roleId])
  @@map("users")
}

// ==================== LOCATION HIERARCHY ====================

model InfrastructureType {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  icon        String?
  color       String?
  deletedAt   DateTime?

  infrastructures Infrastructure[]

  @@map("infrastructure_types")
}

model Infrastructure {
  id          Int       @id @default(autoincrement())
  code        String?
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  infraTypeId Int?
  infraType   InfrastructureType? @relation(fields: [infraTypeId], references: [id])

  dependencies Dependency[]
  structures   Structure[]
  materials    Material[]

  @@index([infraTypeId])
  @@map("infrastructures")
}

model Dependency {
  id               Int       @id @default(autoincrement())
  code             String?
  name             String
  description      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  infrastructureId Int
  infrastructure   Infrastructure @relation(fields: [infrastructureId], references: [id])

  parentId Int?
  parent   Dependency?  @relation("DependencyTree", fields: [parentId], references: [id])
  children Dependency[] @relation("DependencyTree")

  structures Structure[]
  materials  Material[]

  @@unique([infrastructureId, parentId, code], map: "dependencies_infra_parent_code_key")
  @@index([infrastructureId])
  @@index([parentId])
  @@map("dependencies")
}

model Structure {
  id               Int       @id @default(autoincrement())
  code             String?
  name             String
  description      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  infrastructureId Int?
  infrastructure   Infrastructure? @relation(fields: [infrastructureId], references: [id])

  dependencyId Int?
  dependency   Dependency? @relation(fields: [dependencyId], references: [id])

  materials Material[]

  @@index([infrastructureId])
  @@index([dependencyId])
  @@map("structures")
}

// ==================== MATERIAL CATALOG ====================

enum DataType {
  STRING
  NUMBER
  BOOLEAN
  DATE
  ENUM
}

model MaterialType {
  id          Int       @id @default(autoincrement())
  code        String
  name        String
  description String?
  icon        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  categories MaterialCategory[]
  materials  Material[]

  @@map("material_types")
}

model MaterialCategory {
  id          Int      @id @default(autoincrement())
  code        String
  name        String
  description String?
  dataType    DataType
  unit        String?
  required    Boolean  @default(false)
  sortOrder   Int      @default(0)
  enumValues  String[]
  validation  Json?

  materialTypeId Int
  materialType   MaterialType @relation(fields: [materialTypeId], references: [id], onDelete: Cascade)

  @@unique([materialTypeId, code])
  @@index([materialTypeId])
  @@map("material_categories")
}

// ==================== MATERIAL INSTANCES ====================

model Material {
  id           Int       @id @default(autoincrement())
  code         String?
  name         String
  description  String?
  serialNumber String?
  installedAt  DateTime  @default(now())
  attributes   Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  typeId Int
  type   MaterialType @relation(fields: [typeId], references: [id])

  infrastructureId Int?
  infrastructure   Infrastructure? @relation(fields: [infrastructureId], references: [id])

  dependencyId Int?
  dependency   Dependency? @relation(fields: [dependencyId], references: [id])

  structureId Int?
  structure   Structure? @relation(fields: [structureId], references: [id])

  actions Action[]

  @@index([typeId])
  @@index([infrastructureId])
  @@index([dependencyId])
  @@index([structureId])
  @@map("materials")
}

// ==================== ACTIONS ====================

model ActionType {
  id          Int       @id @default(autoincrement())
  code        String
  name        String
  description String?
  icon        String?
  color       String?
  deletedAt   DateTime?

  actions Action[]

  @@map("action_types")
}

model Action {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  performedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  typeId Int
  type   ActionType @relation(fields: [typeId], references: [id])

  materialId Int?
  material   Material? @relation(fields: [materialId], references: [id])

  infrastructureId Int?
  infrastructure   Infrastructure? @relation(fields: [infrastructureId], references: [id])

  dependencyId Int?
  dependency   Dependency? @relation(fields: [dependencyId], references: [id])

  structureId Int?
  structure   Structure? @relation(fields: [structureId], references: [id])

  latitude  Float?
  longitude Float?

  performedBy Int
  performer   User    @relation(fields: [performedBy], references: [id])

  @@index([materialId])
  @@index([infrastructureId])
  @@index([dependencyId])
  @@index([structureId])
  @@index([performedBy])
  @@index([performedAt])
  @@map("actions")
}
