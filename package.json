{
  "name": "infragest",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev --workspace=backend\" \"npm run dev --workspace=@infragest/frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=@infragest/frontend",
    "test:backend": "npm run test --workspace=backend",
    "build:backend": "npm run build --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "9.2.1"
  },
  "dependencies": {
    "depd": "^2.0.0",
    "escape-html": "^1.0.3",
    "mime": "^4.1.0",
    "setprototypeof": "^1.2.0",
    "toidentifier": "^1.0.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.0"
  }
}
